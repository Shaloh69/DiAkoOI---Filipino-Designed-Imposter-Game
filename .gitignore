# NOTE: e2e/**/*-snapshots/ ARE committed. Baselines belong in git

# ── Environment & secrets ───────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ── Docker / DB ─────────────────────────────────────────────────
postgres-data/
pgdata/
*.dump
*.sql.gz

# ── Audio working files ─────────────────────────────────────────
