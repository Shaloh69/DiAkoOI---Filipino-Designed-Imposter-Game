# ── API ─────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3000
API_HOST=0.0.0.0

# ── Postgres ────────────────────────────────────────────────────
POSTGRES_USER=diakooi
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=diakooi
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://diakooi:change_me_locally@localhost:5432/diakooi

# ── Feedback attachments ────────────────────────────────────────
# Content-addressed storage (SHA-256 filenames) + encryption at rest.
# See docs/01-DESIGN.md 16b — hashing is NOT the security control.
ATTACHMENT_STORAGE_PATH=./storage/attachments
# AES-256 key, 64 hex characters. Generate with: openssl rand -hex 32
# When absent the API REFUSES attachments rather than storing them in the
# clear — a refusal is visible, an unencrypted write is not (01-DESIGN §16b).
ATTACHMENT_KEY=
SIGNED_URL_TTL_SECONDS=300

# ── Admin console ───────────────────────────────────────────────
# Real access control is tailnet binding, not this secret.
ADMIN_SESSION_SECRET=generate_a_long_random_string
ADMIN_EMAIL=

# ── Cloudflare Tunnel ───────────────────────────────────────────
# Public API only. Never expose the admin console this way.
CLOUDFLARE_TUNNEL_TOKEN=

# ── Rate limiting ───────────────────────────────────────────────
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# ── Telemetry ───────────────────────────────────────────────────
# DECIDED 2026-08-24: v1 collects none. No endpoint, no table, no flag.
# See docs/adr/0015-no-telemetry-in-v1.md.
