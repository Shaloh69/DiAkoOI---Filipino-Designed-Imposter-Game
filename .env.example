# ── API ─────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3000
API_HOST=0.0.0.0

# ── Postgres ────────────────────────────────────────────────────
POSTGRES_USER=diakooi
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=diakooi
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://diakooi:change_me_locally@localhost:5432/diakooi

# ── Feedback attachments ────────────────────────────────────────
# Content-addressed storage (SHA-256 filenames) + encryption at rest.
# See docs/01-DESIGN.md 16b — hashing is NOT the security control.
ATTACHMENT_STORAGE_PATH=./storage/attachments
ATTACHMENT_ENCRYPTION_KEY=generate_a_32_byte_key
SIGNED_URL_TTL_SECONDS=300

# ── Admin console ───────────────────────────────────────────────
# Real access control is tailnet binding, not this secret.
ADMIN_SESSION_SECRET=generate_a_long_random_string
ADMIN_EMAIL=

# ── Cloudflare Tunnel ───────────────────────────────────────────
# Public API only. Never expose the admin console this way.
CLOUDFLARE_TUNNEL_TOKEN=

# ── Rate limiting ───────────────────────────────────────────────
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# ── Telemetry ───────────────────────────────────────────────────
# Aggregate counters only. No names, photos, or device identifiers.
# Blocked decision — see docs/00-START-HERE.md section 5.
TELEMETRY_ENABLED=false
