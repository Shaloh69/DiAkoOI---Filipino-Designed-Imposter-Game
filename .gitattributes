# Normalise text to LF in the repo; check out native on Windows.
* text=auto eol=lf

# Test baselines are binary and must never be line-ending converted.
*.png binary
*.jpg binary
*.webp binary
*.ttf binary
*.otf binary
*.ogg binary
*.mp3 binary
*.wav binary

# Shell scripts and Docker entrypoints must stay LF even on Windows checkouts.
*.sh text eol=lf
Dockerfile text eol=lf

# Generated Dart is not reviewed.
*.g.dart linguist-generated=true
*.freezed.dart linguist-generated=true
