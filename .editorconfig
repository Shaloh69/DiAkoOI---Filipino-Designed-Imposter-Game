root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.dart]
indent_size = 2
max_line_length = 80

[*.{md,markdown}]
trim_trailing_whitespace = false
max_line_length = 88

[*.{yml,yaml}]
indent_size = 2

[*.csv]
trim_trailing_whitespace = false
insert_final_newline = true

[Makefile]
indent_style = tab
